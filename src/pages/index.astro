---
import { getAllPosts } from '../lib/api';
import Layout from '../layouts/Layout.astro';

const postIds = new Set((await getAllPosts()).map(p => p.id));

const sections = [
  {
    heading: 'SAM/BAM and related specifications',
    ids: ['SAMv1', 'SAMtags', 'CRAMv2.1', 'CRAMv3', 'CRAMcodecs', 'CSIv1', 'tabix'],
  },
  {
    heading: 'Variant calling data files',
    ids: ['VCFv4.1', 'VCFv4.2', 'VCFv4.3', 'VCFv4.4', 'VCFv4.5', 'BCFv1_qref', 'BCFv2_qref'],
  },
  {
    heading: 'Discrete genomic feature data files',
    ids: ['BEDv1'],
  },
  {
    heading: 'File encryption',
    ids: ['crypt4gh'],
  },
];
---

<Layout title="hts-specs-md">
  <p>
    This is an unofficial project by <a href="https://github.com/cmdcolin">cmdcolin</a> to convert the
    <a href="https://samtools.github.io/hts-specs/">hts-specs specifications</a> from their
    original LaTeX/PDF formats into Markdown for easier reading and linking in the browser.
    Each section heading has a clickable anchor link, making it easy to share direct links
    to specific parts of any specification.
  </p>
  <p>
    For the official specifications, please visit the
    <a href="https://samtools.github.io/hts-specs/">samtools/hts-specs</a> project.
  </p>
  {sections.map((section) => (
    <div>
      <h2>{section.heading}</h2>
      <ul>
        {section.ids.filter(id => postIds.has(id)).map(id => (
          <li><a href={`${import.meta.env.BASE_URL}/${id}`}>{id}</a></li>
        ))}
      </ul>
    </div>
  ))}
</Layout>
