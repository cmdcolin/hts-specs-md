---
import { getAllPosts } from '../lib/api';
import Layout from '../layouts/Layout.astro';

const specList = await getAllPosts();
---

<Layout title="hts-specs-md">
  <p>This site provides Markdown renderings of the <a href="https://github.com/samtools/hts-specs">hts-specs</a> specifications.</p>
  <ul>
    {specList.map((spec) => (
      <li>
        {spec.date && <span>{spec.date} - </span>}
        <a href={`${import.meta.env.BASE_URL}/${spec.id}`}>{spec.id}</a>
      </li>
    ))}
  </ul>
</Layout>
