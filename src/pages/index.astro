---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const specs = await getCollection('specs');
const specList = specs.map(entry => ({
  slug: entry.slug,
  title: entry.data.title || entry.slug,
  date: entry.data.date,
})).sort((a, b) => a.title.localeCompare(b.title));
---

<Layout title="HTS Specifications">
  <h1>HTS Specifications</h1>
  <p>This site provides Markdown renderings of the HTS file format specifications.</p>
  <ul>
    {specList.map((spec) => (
      <li>
        <a href={`${import.meta.env.BASE_URL}/${spec.slug}`}>{spec.title}</a>
        {spec.date && <span> ({spec.date})</span>}
      </li>
    ))}
  </ul>
</Layout>
