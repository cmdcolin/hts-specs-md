---
const base = import.meta.env.BASE_URL;
const specs = [
  'SAMv1', 'SAMtags', 'BEDv1',
  'VCFv4.1', 'VCFv4.2', 'VCFv4.3', 'VCFv4.4', 'VCFv4.5',
  'BCFv1_qref', 'BCFv2_qref',
  'CRAMv2.1', 'CRAMv3', 'CRAMcodecs',
  'CSIv1', 'tabix', 'crypt4gh',
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>TeX-to-HTML Converter Comparison</title>
    <style>
      body {
        font-family: "Charter", "Bitstream Charter", "Georgia", serif;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }
      nav { display: flex; gap: 1rem; margin-bottom: 2rem; }
      table { border-collapse: collapse; width: 100%; }
      th, td { border: 1px solid #ddd; padding: 6px 12px; text-align: left; }
      th { background: #f8f9fa; }
      a { color: #0969da; }
    </style>
  </head>
  <body>
    <nav>
      <a href={base}>hts-specs-md</a>
      <a href={`${base}/about`}>About</a>
    </nav>
    <h1>TeX-to-HTML Converter Comparison</h1>
    <p>
      Comparing two approaches for converting hts-specs TeX files to HTML.
      Open each in a new tab to compare side by side.
    </p>
    <table>
      <thead>
        <tr>
          <th>Spec</th>
          <th>Pandoc pipeline</th>
          <th>htlatex (tex4ht)</th>
        </tr>
      </thead>
      <tbody>
        {specs.map(name => (
          <tr>
            <td>{name}</td>
            <td><a href={`${base}/${name}`} target="_blank">Pandoc</a></td>
            <td><a href={`${base}/compare/${name}.html`} target="_blank">htlatex</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </body>
</html>
