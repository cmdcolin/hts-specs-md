---
const base = import.meta.env.BASE_URL;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>TeX-to-HTML Converter Comparison</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        padding: 1rem;
        background: #f5f5f5;
      }
      h1 { font-size: 1.4rem; margin: 0 0 0.5rem; }
      .description { font-size: 0.9rem; color: #555; margin-bottom: 1rem; }
      .tabs {
        display: flex;
        gap: 4px;
        margin-bottom: 0;
      }
      .tab {
        padding: 8px 16px;
        background: #ddd;
        border: 1px solid #ccc;
        border-bottom: none;
        border-radius: 6px 6px 0 0;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
      }
      .tab.active {
        background: white;
        border-bottom: 1px solid white;
        margin-bottom: -1px;
        z-index: 1;
      }
      .frame-container {
        border: 1px solid #ccc;
        background: white;
        border-radius: 0 6px 6px 6px;
      }
      iframe {
        width: 100%;
        height: 85vh;
        border: none;
        display: block;
      }
      nav { margin-bottom: 1rem; }
      nav a { margin-right: 1rem; }
    </style>
  </head>
  <body>
    <nav>
      <a href={base}>hts-specs-md</a>
      <a href={`${base}/about`}>About</a>
    </nav>
    <h1>TeX-to-HTML Converter Comparison: CRAMv3</h1>
    <p class="description">
      Comparing three approaches for converting CRAMv3.tex to HTML:
      our Pandoc pipeline (TeX &rarr; GFM Markdown &rarr; Astro/HTML),
      htlatex/tex4ht (direct TeX &rarr; XHTML+MathML),
      and LaTeXML (TeX &rarr; XML &rarr; HTML5+MathML).
    </p>
    <div class="tabs">
      <div class="tab active" data-src={`${base}/CRAMv3`}>Pandoc (current)</div>
      <div class="tab" data-src={`${base}/compare/CRAMv3-htlatex.html`}>htlatex (tex4ht)</div>
      <div class="tab" data-src={`${base}/compare/CRAMv3-latexml.html`}>LaTeXML</div>
    </div>
    <div class="frame-container">
      <iframe id="viewer" src={`${base}/CRAMv3`}></iframe>
    </div>
    <script>
      document.querySelectorAll('.tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          document.getElementById('viewer').src = tab.dataset.src;
        });
      });
    </script>
  </body>
</html>
