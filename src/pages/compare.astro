---
const base = import.meta.env.BASE_URL;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>TeX-to-HTML Converter Comparison</title>
    <style>
      body {
        font-family: "Charter", "Bitstream Charter", "Georgia", serif;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }
      nav { display: flex; gap: 1rem; margin-bottom: 2rem; }
      ul { line-height: 2; }
      a { color: #0969da; }
    </style>
  </head>
  <body>
    <nav>
      <a href={base}>hts-specs-md</a>
      <a href={`${base}/about`}>About</a>
    </nav>
    <h1>TeX-to-HTML Converter Comparison</h1>
    <p>
      Comparing three approaches for converting CRAMv3.tex to HTML.
      Open each in a new tab to compare side by side.
    </p>
    <ul>
      <li><a href={`${base}/CRAMv3`} target="_blank">Pandoc (current pipeline)</a> — TeX &rarr; GFM Markdown &rarr; Astro/HTML</li>
      <li><a href={`${base}/compare/CRAMv3-htlatex.html`} target="_blank">htlatex (tex4ht)</a> — direct TeX &rarr; XHTML + MathML</li>
      <li><a href={`${base}/compare/CRAMv3-latexml.html`} target="_blank">LaTeXML</a> — TeX &rarr; XML &rarr; HTML5 + MathML</li>
    </ul>
  </body>
</html>
