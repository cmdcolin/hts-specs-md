---
const { title, headings = [], commit, date } = Astro.props;
const base = import.meta.env.BASE_URL;

const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 4 && h.slug !== 'footnote-label');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} - hts-specs-md</title>
    <style is:global>
      body {
        font-family: "Charter", "Bitstream Charter", "Georgia", serif;
        font-size: 0.95rem;
        line-height: 1.6;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
        background-color: white;
        color: black;
      }
      .katex-display {
        margin: 1.2em 0;
        overflow-x: auto;
        overflow-y: hidden;
      }
      pre {
        background-color: #1e1e1e;
        color: #d4d4d4;
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        border: 1px solid #333;
        margin-bottom: 1.5rem;
        font-size: 0.85em;
        line-height: 1.4;
      }
      pre code {
        color: inherit;
        background: transparent !important;
        padding: 0;
      }
      code {
        font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace;
        font-size: 0.85em;
        background: #f6f8fa;
        padding: 0.2em 0.4em;
        border-radius: 3px;
      }
      .code-math-block, .algorithmic {
        background-color: light-dark(#f6f8fa, #2d333b);
        padding: 1rem;
        border-radius: 6px;
        border: 1px solid #d1d5da;
        overflow-x: auto;
        margin-bottom: 1.5rem;
      }
      .code-math-block {
        font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace;
        font-size: 0.85em;
        display: block;
      }
      .code-math-block p {
        margin: 0;
        white-space: pre;
        line-height: 1.45;
      }
      .code-math-block math {
        font-size: 0.9em;
      }
      .algorithmic p {
        margin: 0.25em 0;
      }
      .smallcaps {
        font-variant: small-caps;
      }
      .center {
        text-align: center;
      }
      table.bytebox-diagram {
        width: auto;
        display: inline-table;
        margin: 0.5em 0;
      }
      table.bytebox-diagram td {
        text-align: center;
        padding: 4px 8px;
        white-space: nowrap;
      }
      img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 1rem 0;
      }
      a[href^="http"]:not([href*="localhost"]):not([href*="cmdcolin.github.io"])::after {
        content: " ↗";
        font-size: 0.8em;
        opacity: 0.7;
      }
      :target {
        scroll-margin-top: 2rem;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        margin-bottom: 1rem;
        display: block;
        overflow-x: auto;
      }
      tfoot.tablenotes td {
        font-size: 0.85em;
        color: GrayText;
        background: #f8f9fa;
        border-top: 2px solid #bbb;
      }
      th, td {
        border: 1px solid #ddd;
        padding: 2px 8px;
        text-align: left;
        line-height: 1.3;
      }
      th {
        background-color: #f8f9fa;
      }
      h1, h2, h3, h4 {
        border-bottom: 1px solid #eaecef;
        padding-bottom: 0.3em;
        margin-top: 1.5rem;
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }
      .header-anchor {
        text-decoration: none;
        font-size: 0.8em;
      }
      .banner {
        background: #fff8e1;
        border: 1px solid #ffe082;
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
        margin-bottom: 1rem;
      }
      .toc {
        background: #f6f8fa;
        padding: 0.5rem 0.75rem;
        border-radius: 6px;
        border: 1px solid #d1d5da;
        margin-bottom: 1.5rem;
        font-size: 0.8rem;
      }
      .toc summary {
        cursor: pointer;
        font-weight: 600;
        font-size: 0.85rem;
      }
      .toc ul {
        list-style: none;
        padding-left: 0;
        margin: 0.25rem 0 0 0;
        columns: 2;
        column-gap: 1.5rem;
      }
      .toc li {
        margin: 0.1rem 0;
        line-height: 1.25;
        break-inside: avoid;
      }
      .toc .depth-3 {
        padding-left: 0.75rem;
      }
      .toc .depth-4 {
        padding-left: 1.5rem;
      }
      .toc a:hover {
        text-decoration: underline;
      }
      nav {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        align-items: center;
      }
      @media (max-width: 768px) {
        body {
          padding: 0.5rem;
          font-size: 0.9rem;
        }
        h1 {
          font-size: 1.3rem;
        }
        h2 { font-size: 1.1rem; }
        h3 { font-size: 1rem; }
        pre, .code-math-block, .algorithmic {
          padding: 0.5rem;
          border-radius: 0;
          margin-left: -0.5rem;
          margin-right: -0.5rem;
        }
        table {
          font-size: 0.8rem;
        }
        th, td {
          padding: 4px 6px;
        }
        .toc ul {
          columns: 1;
        }
        ul, ol {
          padding-left: 1.2rem;
        }
        .banner {
          border-radius: 0;
          margin-left: -0.5rem;
          margin-right: -0.5rem;
        }
        nav {
          margin-bottom: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <nav>
      <a href={base}>hts-specs-md</a>
      <a href={`${base}/about`}>About</a>
    </nav>
    <main>
      <h1>{title}</h1>
      {commit && (
        <p class="banner"><strong>This is an unofficial HTML rendering of the specification.</strong> The official specification is maintained at <a href="https://github.com/samtools/hts-specs">samtools/hts-specs</a>. This rendering is based on commit <a href={`https://github.com/samtools/hts-specs/commit/${commit}`}><code>{commit}</code></a>{date && `, dated ${date}`}.</p>
      )}
      {tocHeadings.length > 0 && (
        <details class="toc">
          <summary>Table of Contents</summary>
          <ul>
            {tocHeadings.map(h => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text.replace(/ ?#$/, '')}</a>
              </li>
            ))}
          </ul>
        </details>
      )}
      <slot />
    </main>
  </body>
</html>
