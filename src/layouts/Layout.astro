---
const { title, headings = [] } = Astro.props;
const base = import.meta.env.BASE_URL;

// Filter and format headings for the TOC
const tocHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 4);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} - hts-specs-md</title>
    <style is:global>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 0.95rem;
        line-height: 1.6;
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem;
        color: #24292e;
        background-color: #ffffff;
      }
      /* Native MathML styling to match page fonts */
      math {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 0.9em;
      }
      /* Aggressively target MathML internals to prevent serif defaults */
      math, math * {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
        font-style: normal !important;
        mathvariant: normal !important;
        text-transform: none !important;
      }
      /* Firefox-specific fix for MathML tokens */
      @-moz-document url-prefix() {
        math mi, math mo, math mn, math mtext {
          font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
        }
      }
      /* Allow operators to stretch if needed but keep font */
      math mo {
        font-variant-logic: normal !important;
      }
      .katex-display {
        margin: 1.2em 0;
        overflow-x: auto;
        overflow-y: hidden;
      }
      pre {
        background-color: #1e1e1e;
        color: #d4d4d4;
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        border: 1px solid #333;
        margin-bottom: 1.5rem;
        font-size: 0.85em;
        line-height: 1.4;
      }
      pre code {
        color: inherit;
        background: transparent !important;
        padding: 0;
      }
      code {
        font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace;
        font-size: 0.85em;
        background: #f6f8fa;
        padding: 0.2em 0.4em;
        border-radius: 3px;
      }
      .code-math-block {
        background-color: #f6f8fa;
        padding: 1rem;
        border-radius: 6px;
        border: 1px solid #d1d5da;
        font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace;
        font-size: 0.85em;
        overflow-x: auto;
        margin-bottom: 1.5rem;
        color: #24292e;
        display: block;
      }
      .code-math-block p {
        margin: 0;
        white-space: pre;
        line-height: 1.45;
      }
      /* Ensure math elements in code blocks don't add extra vertical space */
      .code-math-block math {
        font-size: 0.9em;
      }
      img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 1rem 0;
      }
      a[href^="http"]:not([href*="localhost"]):not([href*="cmdcolin.github.io"])::after {
        content: " ↗";
        font-size: 0.8em;
        opacity: 0.7;
      }
      /* Prevent anchor tags used for section links from affecting layout */
      a[id] {
        display: block;
        position: relative;
        top: -2rem; /* Offset for header/nav if any, though here we just want it to exist */
        visibility: hidden;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        margin-bottom: 1rem;
        display: block;
        overflow-x: auto;
      }
      th, td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
      }
      th {
        background-color: #f8f9fa;
      }
      h1, h2, h3, h4 {
        border-bottom: 1px solid #eaecef;
        padding-bottom: 0.3em;
        margin-top: 1.5rem;
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }
      .header-anchor {
        opacity: 0;
        text-decoration: none;
        color: #ccc;
        font-size: 0.8em;
        transition: opacity 0.2s;
      }
      h1:hover .header-anchor,
      h2:hover .header-anchor,
      h3:hover .header-anchor,
      h4:hover .header-anchor {
        opacity: 1;
      }
      .header-anchor:hover {
        color: #0366d6;
      }
      .toc {
        background: #f6f8fa;
        padding: 0.75rem;
        border-radius: 6px;
        border: 1px solid #d1d5da;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
      }
      .toc h2 {
        margin-top: 0;
        margin-bottom: 0.5rem;
        border: none;
        font-size: 1rem;
        font-weight: 600;
      }
      .toc ul {
        list-style: none;
        padding-left: 0;
        margin: 0;
      }
      .toc li {
        margin: 0.2rem 0;
        line-height: 1.3;
      }
      .toc .depth-3 {
        padding-left: 0.75rem;
      }
      .toc .depth-4 {
        padding-left: 1.5rem;
      }
      .toc a {
        text-decoration: none;
        color: #0366d6;
      }
      .toc a:hover {
        text-decoration: underline;
      }
      nav {
        margin-bottom: 2rem;
      }
      nav {
        display: flex;
        gap: 1rem;
      }
      nav a {
        text-decoration: none;
        color: #0366d6;
      }
    </style>
  </head>
  <body>
    <nav>
      <a href={base}>hts-specs-md</a>
      <a href={`${base}/about`}>About</a>
    </nav>
    <main>
      <h1>{title}</h1>
      {tocHeadings.length > 0 && (
        <div class="toc">
          <h2>Table of Contents</h2>
          <ul>
            {tocHeadings.map(h => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <slot />
    </main>
  </body>
</html>
